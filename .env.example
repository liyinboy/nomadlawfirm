# Salin file ini menjadi ".env" lalu sesuaikan nilainya sebelum menjalankan server.

# Port server berjalan
PORT=3000

# Kunci rahasia untuk session login admin — ganti dengan teks acak yang panjang
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang-dan-unik

# Akun admin default yang dibuat otomatis saat database masih kosong
# (hanya berlaku pada saat pertama kali server dijalankan)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=nomad@admin123

# Koneksi database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nomad_lawfirm
