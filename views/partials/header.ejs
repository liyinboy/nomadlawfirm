<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' && title ? title + ' | ' + settings.shortName : settings.officeName %></title>
<meta name="description" content="<%= settings.officeName %> adalah firma hukum yang menangani perkara pidana, perdata, keluarga, waris, hingga korporasi.">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#0a1830">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="<%= settings.shortName %>">
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
</head>
<body class="has-bottom-nav">

<nav class="navbar">
  <div class="container-wide">
    <a href="/" class="brand">
      <img src="/images/logo.png" alt="Logo <%= settings.officeName %>">
      <div class="brand-text">
        <strong>NOMAD LAW FIRM</strong>
        <span><%= settings.tagline %></span>
      </div>
    </a>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Beranda</a></li>
      <li><a href="/tentang-kami" class="<%= currentPath === '/tentang-kami' ? 'active' : '' %>">Tentang Kami</a></li>
      <li><a href="/layanan" class="<%= currentPath === '/layanan' ? 'active' : '' %>">Layanan</a></li>
      <li><a href="/tim-kami" class="<%= currentPath === '/tim-kami' ? 'active' : '' %>">Tim Kami</a></li>
      <li><a href="/berita" class="<%= currentPath.startsWith('/berita') ? 'active' : '' %>">Berita</a></li>
      <li><a href="/galeri" class="<%= currentPath === '/galeri' ? 'active' : '' %>">Galeri</a></li>
      <li><a href="/mitra" class="<%= currentPath === '/mitra' ? 'active' : '' %>">Mitra</a></li>
    </ul>
    <div class="nav-cta">
      <% if (currentUser) { %>
      <a href="/akun-saya" class="nav-account-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/></svg>
        <%= currentUser.name.split(' ')[0] %>
      </a>
      <% } else { %>
      <a href="/masuk" class="nav-account-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/></svg>
        Masuk
      </a>
      <% } %>
      <a href="/ajukan-kasus" class="nav-wa" style="border-color:var(--red-bright); background:rgba(29,78,216,.12);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        Ajukan Kasus
      </a>
      <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="nav-wa">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.76.46 3.48 1.35 5L2 22l5.15-1.35c1.46.8 3.1 1.22 4.89 1.22 5.52 0 10-4.48 10-10s-4.48-10-10-10zm0 18.15c-1.6 0-3.16-.43-4.52-1.24l-.32-.19-3.05.8.82-2.97-.21-.32A8.13 8.13 0 013.87 12c0-4.5 3.66-8.15 8.17-8.15S20.2 7.5 20.2 12s-3.66 8.15-8.16 8.15zm4.47-6.1c-.24-.12-1.44-.71-1.67-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.53.06-.24-.12-1.02-.38-1.95-1.21-.72-.64-1.2-1.44-1.35-1.68-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42-.14-.01-.3-.01-.46-.01-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28z"/></svg>
        WhatsApp
      </a>
      <button class="nav-toggle" aria-label="Buka menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-menu">
  <ul>
    <li><a href="/">Beranda</a></li>
    <li><a href="/tentang-kami">Tentang Kami</a></li>
    <li><a href="/layanan">Layanan</a></li>
    <li><a href="/tim-kami">Tim Kami</a></li>
    <li><a href="/berita">Berita</a></li>
    <li><a href="/galeri">Galeri</a></li>
    <li><a href="/mitra">Mitra</a></li>
    <li><a href="/konsultasi">Konsultasi</a></li>
    <li><a href="/ajukan-kasus">Ajukan Kasus</a></li>
    <li><a href="/kontak">Kontak</a></li>
    <% if (currentUser) { %>
    <li><a href="/akun-saya">Akun Saya</a></li>
    <% } else { %>
    <li><a href="/masuk">Masuk / Daftar</a></li>
    <% } %>
  </ul>
  <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="nav-wa">Hubungi via WhatsApp</a>
</div>
