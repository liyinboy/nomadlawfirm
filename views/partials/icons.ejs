<%
/* icon: gavel | scale | family | document | building | chat | book | heart | users */
%>
<% if (icon === 'gavel') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 5l5 5M9 10l5 5M2 22l7-7M12.5 4.5l7 7M6 15l3.5-3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
<% } else if (icon === 'scale') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v18M5 7h14M5 7L2 13a3 3 0 006 0L5 7zM19 7l-3 6a3 3 0 006 0l-3-6zM8 21h8" stroke-linecap="round" stroke-linejoin="round"/></svg>
<% } else if (icon === 'family') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="6" r="2.5"/><circle cx="16" cy="6" r="2.5"/><path d="M3 20v-2a4 4 0 014-4h2a4 4 0 014 4M11 20v-2a4 4 0 014-4h2a4 4 0 014 4v2" stroke-linecap="round" stroke-linejoin="round"/></svg>
<% } else if (icon === 'document') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 3h7l4 4v14a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1z" stroke-linejoin="round"/><path d="M14 3v4h4M9 13h6M9 17h6M9 9h2" stroke-linecap="round"/></svg>
<% } else if (icon === 'building') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 21V7l8-4 8 4v14M4 21h16M9 21v-6h6v6M9 11h.01M9 15h.01M15 11h.01M15 15h.01" stroke-linecap="round" stroke-linejoin="round"/></svg>
<% } else if (icon === 'chat') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
<% } else if (icon === 'book') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 016.5 17H20" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 7h7M9 11h7" stroke-linecap="round"/></svg>
<% } else if (icon === 'heart') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 00-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
<% } else if (icon === 'users') { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20.5c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5"/><path d="M16 4.5a3.5 3.5 0 010 7M21.5 20.5c0-2.8-1.9-5.1-4.5-6" stroke-linecap="round"/></svg>
<% } else { %>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg>
